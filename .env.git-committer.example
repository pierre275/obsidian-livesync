# Path to the git repository where vault files are written
VAULT_PATH=/path/to/your/vault

# Path to the livesync local database + settings.json
# Must contain .livesync/settings.json configured with CouchDB credentials
LIVESYNC_DATA_PATH=/path/to/livesync-data

# Path to SSH directory containing the key used for git push
SSH_PATH=/root/.ssh

# Seconds of silence on the CouchDB changes feed before committing
DEBOUNCE_SECS=30

# Git remote and branch to push to
GIT_REMOTE=origin
GIT_BRANCH=main

# Git commit author identity
GIT_USER_NAME=livesync-bot
GIT_USER_EMAIL=livesync-bot@example.com
